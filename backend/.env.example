NODE_ENV=development
PORT=3000
# Origenes permitidos por CORS, separados por coma
CORS_ORIGINS=http://localhost:5173

DB_SERVER=localhost
DB_PORT=1433
DB_NAME=ShopCart
DB_USER=
DB_PASSWORD=
DB_ENCRYPT=false
DB_TRUST_SERVER_CERT=true

# Minimo 32 caracteres. Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=7
BCRYPT_ROUNDS=12

# Cada cuantos segundos se liberan las reservas de existencia vencidas (0 = desactivar el job)
RESERVAS_JOB_SEGUNDOS=60

# Limite de intentos por IP y minuto en /api/auth/* (subirlo, p. ej. a 1000, solo para correr pnpm concurrencia)
RATE_LIMIT_AUTH_POR_MINUTO=20
